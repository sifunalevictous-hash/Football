rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // User Rules
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // For leaderboard
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalPredictions', 'correctResults', 'correctScores', 'accuracy', 'displayName'])
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'totalPredictions', 'correctResults', 'correctScores', 'accuracy'])
        && data.uid is string
        && data.displayName is string && data.displayName.size() <= 50
        && data.totalPredictions is number
        && data.correctResults is number
        && data.correctScores is number
        && data.accuracy is number;
    }

    // Prediction Rules
    match /predictions/{predictionId} {
      allow get: if isOwner(resource.data.userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isOwner(request.resource.data.userId) && isValidPrediction(request.resource.data);
      allow update: if false; // Predictions are immutable once made, or only updated by system
      allow delete: if isOwner(resource.data.userId);
    }

    function isValidPrediction(data) {
      return data.keys().hasAll(['userId', 'fixtureId', 'predictedWinner', 'predictedScore', 'timestamp', 'status'])
        && data.userId == request.auth.uid
        && data.fixtureId is string
        && data.predictedWinner is string
        && data.predictedScore is string
        && data.timestamp is timestamp
        && data.status in ['PENDING', 'PROCESSED'];
    }
  }
}
